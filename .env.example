# ==============================================================================
# AAZHI Ocean Platform - Environment Variables
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=false

# Security & CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Custom Storage Directories (Optional overrides)
# DATA_DIR=/app/data
# TILES_DIR=/app/tiles
# FRONTEND_DIST_DIR=/app/frontend/dist
